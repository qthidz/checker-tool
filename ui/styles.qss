/*
 * PHONG CÁCH DARK NEON GLASS
 */
QWidget {
    background-color: #0F1115;
    color: #E2E8F0;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

/* Thanh Topbar */
QFrame#TopBar {
    background-color: #1A1D24;
    border-bottom: 1px solid #2D313A;
}
QLabel#LogoText {
    font-size: 16px;
    font-weight: bold;
    color: #00F0FF;
}

/* Nút Close/Minimize custom */
QPushButton#BtnClose {
    background-color: transparent;
    color: #94A3B8;
    font-weight: bold;
    border: none;
    border-radius: 4px;
}
QPushButton#BtnClose:hover {
    background-color: #E74C3C;
    color: white;
}
QPushButton#BtnMin {
    background-color: transparent;
    color: #94A3B8;
    font-weight: bold;
    border: none;
    border-radius: 4px;
}
QPushButton#BtnMin:hover {
    background-color: #F39C12;
    color: white;
}

/* Sidebar */
QFrame#SideBar {
    background-color: #1A1D24;
    border-right: 1px solid #2D313A;
}
QPushButton.SideBtn {
    background-color: transparent;
    color: #94A3B8;
    text-align: left;
    padding: 12px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
}
QPushButton.SideBtn:hover {
    background-color: #252A34;
    color: #E2E8F0;
}
QPushButton.SideBtn:checked {
    background-color: #252A34;
    color: #00F0FF;
    border-left: 3px solid #00F0FF;
}

/* Nội dung chính */
QStackedWidget {
    background-color: #0F1115;
}
QFrame.Page {
    background-color: #0F1115;
}
QLabel.PageTitle {
    font-size: 20px;
    font-weight: bold;
    color: #E2E8F0;
}

/* Nút Button Neon */
QPushButton.BtnNeon {
    background-color: #1E222A;
    color: #00F0FF;
    border: 1px solid #00F0FF;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton.BtnNeon:hover {
    background-color: #00F0FF;
    color: #000000;
}
QPushButton.BtnNeon:disabled {
    background-color: #1E222A;
    color: #555;
    border: 1px solid #333;
}

/* Ô nhập liệu */
QLineEdit {
    background-color: #1E222A;
    color: #E2E8F0;
    border: 1px solid #2D313A;
    border-radius: 6px;
    padding: 8px;
}
QLineEdit:focus {
    border: 1px solid #00F0FF;
}

/* Log Text */
QTextEdit {
    background-color: #000000;
    color: #00FF00;
    font-family: "Consolas", monospace;
    border: 1px solid #2D313A;
    border-radius: 6px;
}